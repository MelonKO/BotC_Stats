; BotC API Configuration — TEMPLATE
;
; Copy this file to config.ini and fill in your connection settings,
; or edit them on the Settings tab of DBConnect (they are saved to config.ini).
; config.ini is ignored by Git: never commit a real API key.
[Connection]
API_URL = https://localhost:443
API_KEY =
SSL_VERIFY = false

[UI]
; Interface language: auto = the operating system language, otherwise a
; language code with an embedded catalog, for example en or ru.
LANGUAGE = auto
