<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
    <author/>
    <comment/>
    <exportmacro/>
    <class>botc::ui::ImportRolesWidget</class>
    <widget class="QWidget" name="botc::ui::ImportRolesWidget">
        <layout class="QVBoxLayout" name="mainLayout">
            <property name="margin">
                <number>16</number>
            </property>
            <property name="spacing">
                <number>10</number>
            </property>
            <!-- Заголовок -->
            <item>
                <widget class="QLabel">
                    <property name="text">
                        <string>Импорт ролей</string>
                    </property>
                    <property name="styleSheet">
                        <string>font-size: 16px; font-weight: bold;</string>
                    </property>
                </widget>
            </item>
            <!-- Выбор файла -->
            <item>
                <widget class="QGroupBox">
                    <property name="title">
                        <string>Файл CSV</string>
                    </property>
                    <layout class="QHBoxLayout">
                        <item>
                            <widget class="QLineEdit" name="filePathEdit">
                                <property name="readOnly">
                                    <bool>true</bool>
                                </property>
                                <property name="placeholderText">
                                    <string>Путь к CSV файлу...</string>
                                </property>
                            </widget>
                        </item>
                        <item>
                            <widget class="QPushButton" name="browseButton">
                                <property name="text">
                                    <string>Обзор...</string>
                                </property>
                                <property name="maximumWidth">
                                    <number>90</number>
                                </property>
                            </widget>
                        </item>
                        <item>
                            <widget class="QPushButton" name="clearButton">
                                <property name="text">
                                    <string>Очистить</string>
                                </property>
                                <property name="maximumWidth">
                                    <number>90</number>
                                </property>
                            </widget>
                        </item>
                    </layout>
                </widget>
            </item>

            <!-- Ошибки валидации (скрыто по умолчанию) -->
            <item>
                <widget class="QGroupBox" name="errorsGroup">
                    <property name="title">
                        <string>⚠ Ошибки валидации</string>
                    </property>
                    <property name="styleSheet">
                        <string>QGroupBox { color: red; }</string>
                    </property>
                    <property name="visible">
                        <bool>false</bool>
                    </property>
                    <!-- Запрещаем растягиваться по вертикали -->
                    <property name="sizePolicy">
                        <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
                            <horstretch>0</horstretch>
                            <verstretch>0</verstretch>
                        </sizepolicy>
                    </property>
                    <layout class="QVBoxLayout">
                        <item>
                            <widget class="QListWidget" name="errorsWidget">
                            </widget>
                        </item>
                    </layout>
                </widget>
            </item>

            <!-- Предпросмотр -->
            <item>
                <widget class="QGroupBox">
                    <property name="title">
                        <string>Предпросмотр</string>
                    </property>
                    <layout class="QVBoxLayout">

                        <!-- Переключатель языка -->
                        <item>
                            <layout class="QHBoxLayout">
                                <item>
                                    <widget class="QLabel">
                                        <property name="text">
                                            <string>Язык:</string>
                                        </property>
                                    </widget>
                                </item>
                                <item>
                                    <widget class="QComboBox" name="languageCombo">
                                        <property name="minimumWidth">
                                            <number>120</number>
                                        </property>
                                    </widget>
                                </item>
                                <item>
                                    <spacer>
                                        <property name="orientation">
                                            <enum>Qt::Horizontal</enum>
                                        </property>
                                    </spacer>
                                </item>
                            </layout>
                        </item>

                        <!-- Таблица -->
                        <item>
                            <widget class="QTableWidget" name="previewTable">
                                <property name="minimumHeight">
                                    <number>250</number>
                                </property>
                                <property name="selectionBehavior">
                                    <enum>QAbstractItemView::SelectRows</enum>
                                </property>
                                <property name="alternatingRowColors">
                                    <bool>true</bool>
                                </property>
                                <property name="editTriggers">
                                    <set>QAbstractItemView::NoEditTriggers</set>
                                </property>
                            </widget>
                        </item>

                    </layout>
                </widget>
            </item>

            <!-- Статус + кнопка импорта -->
            <item>
                <layout class="QHBoxLayout">
                    <item>
                        <widget class="QLabel" name="statusLabel">
                            <property name="text">
                                <string></string>
                            </property>
                        </widget>
                    </item>
                    <item>
                        <spacer>
                            <property name="orientation">
                                <enum>Qt::Horizontal</enum>
                            </property>
                        </spacer>
                    </item>
                    <item>
                        <widget class="QPushButton" name="importButton">
                            <property name="text">
                                <string>Импортировать</string>
                            </property>
                            <property name="enabled">
                                <bool>false</bool>
                            </property>
                            <property name="minimumWidth">
                                <number>120</number>
                            </property>
                        </widget>
                    </item>
                </layout>
            </item>
        </layout>
    </widget>
    <pixmapfunction/>
    <connections/>
</ui>