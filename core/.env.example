# PostgreSQL Configuration
POSTGRES_DB=botc_stats
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Application user (limited privileges)
BOTC_USER_PASSWORD=change_me

# API service user (for FastAPI → PostgreSQL connection)
API_SERVICE_PASSWORD=change_me

# Metabase metadata DB user (read/write в базе metabase)
METABASE_META_PASSWORD=change_me

# Metabase read-only user (SELECT на аналитических view в botc_stats)
METABASE_READONLY_PASSWORD=change_me

# Секрет для подписи JWT при Static Embedding (мин. 32 случайных символа)
# Сгенерировать: openssl rand -hex 32
METABASE_EMBEDDING_SECRET=change_me_use_random_32chars

# IP-адрес сервера (используется в MB_SITE_URL)
SERVER_IP=your_server_ip

# ============================================================
# SSH-доступ к базе данных (для администратора)
# ============================================================
# Порт 5432 НЕ пробрасывается наружу. Подключение только через SSH-туннель:
#
#   ssh -L 5432:localhost:5432 botc-ssh@<SERVER_IP>
#
# После установления туннеля подключение:
#   psql -h localhost -p 5432 -U botc_user -d botc_stats
#
# Подробная документация: docs/SSH-ACCESS.md

# ============================================================
# REST API для внешних импортеров
# ============================================================
# API доступен по HTTPS: https://<SERVER_IP>:443
# Аутентификация: заголовок X-API-Key
#
# Создание API-ключей:
#   bash scripts/create-api-key.sh create "Имя Фамилия"
#
# Подробная документация: docs/API-ACCESS.md
